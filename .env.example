# ==============================================================================
# PLANTILLA DE CONFIGURACION
# ==============================================================================
# Copie este archivo como `.env` y rellene lo que necesite.
# TODAS las claves son opcionales: si se omiten, el sistema las descubre solo
# o pide el dato por pantalla. Ninguna ruta esta escrita en el codigo fuente.
# ==============================================================================

# --- Agente de IA -------------------------------------------------------------
# Clave de Google Gemini. Se obtiene gratis en https://aistudio.google.com/
# Tambien se puede pegar directamente en la barra lateral de la interfaz web.
GEMINI_API_KEY=

# Modelo a usar. Por defecto: gemini-3.5-flash
MODELO_LLM=gemini-3.5-flash

# Memoria conversacional: cantidad de turnos que el agente recuerda (por defecto: 30)
TURNOS_RECORDADOS=30

# --- Datos --------------------------------------------------------------------
# Ruta del dataset crudo de biodiversidad (descarga de GBIF).
# Si se deja vacio, el sistema busca el archivo tabular mas pesado que haya en
# la carpeta del proyecto o en la carpeta que la contiene.
DATASET_BIODIVERSIDAD=

# Ruta de la Geodatabase (.gdb). Si se deja vacio, se busca automaticamente en
# la carpeta que contiene el proyecto.
GDB_PATH=

# Carpeta de los diccionarios de datos en Excel.
EXCEL_DIR=

# --- Cartografia --------------------------------------------------------------
# Archivo local con los limites municipales nacionales. Util si no hay internet.
RUTA_MUNICIPIOS_NACIONAL=

# URL alternativa de los limites municipales nacionales.
URL_MUNICIPIOS_NACIONAL=

# --- Capas de la Geodatabase --------------------------------------------------
# Solo si la deteccion automatica elige la capa equivocada. Escriba el nombre
# EXACTO de la capa dentro de la Geodatabase.
CAPA_MUNICIPIO=
CAPA_VEREDA=
CAPA_CUENCA=
CAPA_AREAS_PROTEGIDAS=
CAPA_PARAMO=

# --- Servidor -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# API_URL sobrescribe host y puerto si se necesita apuntar a otro servidor.
API_URL=
TEMP_DIR=

# --- Ambito geografico --------------------------------------------------------
# Pais al que se limita el filtrado de biodiversidad (codigo ISO de 2 letras).
# Hace falta porque los nombres de departamento se repiten entre paises:
# "Amazonas" existe en Colombia, Brasil, Peru y Venezuela. Por defecto: CO.
PAIS_ESTUDIO=CO

# ------------------------------------------------------------------------------
# CORPUS DOCUMENTAL (opcional)
# ------------------------------------------------------------------------------
# Carpeta con la bibliografia que consulta el agente: catalogos, listas de
# chequeo, plantas hospederas, ciclos de vida, riesgo climatico.
# Si no se indica, se usa la carpeta 'corpus' dentro del proyecto.
# RUTA_CORPUS=D:\Documentos\bibliografia mariposas

# ------------------------------------------------------------------------------
# INTERFAZ WEB
# ------------------------------------------------------------------------------
# Puerto en el que Streamlit publica el panel. Lo lee iniciar_interfaz_web.bat.
# STREAMLIT_PORT=8501

# ------------------------------------------------------------------------------
# MODELO DE LENGUAJE
# ------------------------------------------------------------------------------
# El sistema responde solo con Gemini: no hay proveedor que elegir. Lo unico
# que hace falta es la clave de arriba.
#
#
# Modelo de embeddings para la busqueda por significado. Es distinto del de

# ------------------------------------------------------------------------------
# FUENTE DE LOS DOCUMENTOS
# ------------------------------------------------------------------------------
# De donde salen los documentos que el agente estudia.
#   local -> la carpeta corpus/ del proyecto          (hoy)
#   drive -> una carpeta compartida de Google Drive   (cuando haya acceso)
# Cambiar esta linea es lo unico que hace falta: no hay que tocar codigo.
# FUENTE_CORPUS=local

# Solo para FUENTE_CORPUS=drive. El identificador sale de la direccion de la
# carpeta en el navegador, y las credenciales son las de una cuenta de servicio
# de Google Cloud con permiso de SOLO LECTURA sobre esa carpeta.
#
# OJO, el paso que mas se olvida: hay que COMPARTIR la carpeta de Drive con el
# correo de la cuenta de servicio. Tener el JSON no da acceso por si solo.
# Los pasos completos estan en documentos/Credenciales_Drive.md
#
# El JSON es una contrasena: esta en .gitignore y no se sube nunca.
# En Docker la ruta es la de DENTRO del contenedor: /app/config/...
# DRIVE_CARPETA_ID=
# GOOGLE_CREDENCIALES=C:\ruta\a\credenciales_drive.json

# ------------------------------------------------------------------------------
# BASE VECTORIAL (QDRANT)
# ------------------------------------------------------------------------------
# Si QDRANT_URL esta VACIA se usa el modo embebido, que guarda en una carpeta
# del disco y no necesita Docker. Es lo adecuado para trabajar en el equipo.
# Con docker compose, el propio compose la define como http://qdrant:6333.
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLECCION=corpus_lepidopteros
# QDRANT_RUTA_LOCAL=corpus/.qdrant

# `gemini-embedding-001` devuelve 3072 dimensiones, pero admite recortarlas.
# Con 768 el indice ocupa la cuarta parte y la busqueda es mas rapida.
# OJO: si cambias este valor hay que reindexar TODO el corpus desde cero, porque
# los vectores viejos tienen otro tamano y no se pueden comparar.
# DIMENSIONES_EMBEDDING=768

# Fragmentos por peticion de embeddings. Medido contra la API gratuita: 32 pasa
# y 100 devuelve 429 por cuota agotada. No lo subas sin medir.
# LOTE_EMBEDDINGS=32

# Cuantas fichas se admiten de UN solo documento. Es el limite que decide que
# entra al indice, y sustituye al antiguo tope en megas: los megas no predicen
# el coste (1 MB de CSV da ~1.485 fichas; 1 MB de informe con fotos, decenas),
# y lo que se paga a la API de embeddings es cada ficha.
#
# Subirlo deja entrar documentos mas largos y gasta mas cuota. Lo que se pase
# no desaparece: se cataloga leyendo su cabecera, y el agente puede decir que
# existe y que columnas trae.
PRESUPUESTO_FICHAS=2000
