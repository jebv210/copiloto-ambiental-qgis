# ==============================================================================
# PLANTILLA DE CONFIGURACION
# ==============================================================================
# Copie este archivo como `.env` y rellene lo que necesite.
# TODAS las claves son opcionales: si se omiten, el sistema las descubre solo
# o pide el dato por pantalla. Ninguna ruta esta escrita en el codigo fuente.
# ==============================================================================

# --- Agente de IA -------------------------------------------------------------
# Clave de Google Gemini. Se obtiene gratis en https://aistudio.google.com/
# Tambien se puede pegar directamente en la barra lateral de la interfaz web.
GEMINI_API_KEY=

# Modelo a usar. Por defecto: gemini-2.5-flash
MODELO_LLM=

# --- Datos --------------------------------------------------------------------
# Ruta del dataset crudo de biodiversidad (descarga de GBIF).
# Si se deja vacio, el sistema busca el archivo tabular mas pesado que haya en
# la carpeta del proyecto o en la carpeta que la contiene.
DATASET_BIODIVERSIDAD=

# Ruta de la Geodatabase (.gdb). Si se deja vacio, se busca automaticamente en
# la carpeta que contiene el proyecto.
GDB_PATH=

# Carpeta de los diccionarios de datos en Excel.
EXCEL_DIR=

# --- Cartografia --------------------------------------------------------------
# Archivo local con los limites municipales nacionales. Util si no hay internet.
RUTA_MUNICIPIOS_NACIONAL=

# URL alternativa de los limites municipales nacionales.
URL_MUNICIPIOS_NACIONAL=

# --- Capas de la Geodatabase --------------------------------------------------
# Solo si la deteccion automatica elige la capa equivocada. Escriba el nombre
# EXACTO de la capa dentro de la Geodatabase.
CAPA_MUNICIPIO=
CAPA_VEREDA=
CAPA_CUENCA=
CAPA_AREAS_PROTEGIDAS=
CAPA_PARAMO=

# --- Servidor -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# API_URL sobrescribe host y puerto si se necesita apuntar a otro servidor.
API_URL=
TEMP_DIR=

# --- Ambito geografico --------------------------------------------------------
# Pais al que se limita el filtrado de biodiversidad (codigo ISO de 2 letras).
# Hace falta porque los nombres de departamento se repiten entre paises:
# "Amazonas" existe en Colombia, Brasil, Peru y Venezuela. Por defecto: CO.
PAIS_ESTUDIO=CO
